    {
      "name": "1-Felhasznalo",
      "item": [
        {
          "name": "POST Regisztracio",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Státusz kód ellenőrzés\r",
                  "pm.test(\"Sikeres regisztráció - 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// 2. Success mező ellenőrzés\r",
                  "pm.test(\"Success mező true\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.success).to.be.true;\r",
                  "});\r",
                  "\r",
                  "// 3. Token automatikus mentése environment-be\r",
                  "pm.test(\"Token automatikus mentése\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    if (jsonData.token) {\r",
                  "        pm.environment.set(\"token\", jsonData.token);\r",
                  "        console.log(\"✅ Token elmentve\");\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "// 4. Felhasználó ID mentése\r",
                  "pm.test(\"Felhasználó ID mentése\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    if (jsonData.felhasznalo && jsonData.felhasznalo._id) {\r",
                  "        pm.environment.set(\"felhasznaloId\", jsonData.felhasznalo._id);\r",
                  "        console.log(\"✅ Felhasználó ID:\", jsonData.felhasznalo._id);\r",
                  "    }\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"felhasznaloNev\": \"tesztUser1\",\r\n  \"email\": \"teszt1@example.com\",\r\n  \"jelszo\": \"jelszo123\",\r\n  \"nev\": \"Teszt Felhasználó\",\r\n  \"lokacio\": {\r\n    \"orszag\": \"Magyarország\",\r\n    \"regio\": \"Komárom-Esztergom\",\r\n    \"telepules\": \"Tatabánya\"\r\n  }\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/felhasznalo/regisztracio\n",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "felhasznalo",
                "regisztracio\n"
              ]
            }
          },
