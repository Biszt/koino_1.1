# backend/.env.prod.example — MINTA az éles környezeti fájlhoz.
# Ez a fájl a gitben van (nincs benne valódi titok). Új gépen (pl. a jövőbeli
# szerver-gépen) másold le `.env.prod` néven, és tölts bele VALÓDI értékeket:
#
#   cp backend/.env.prod.example backend/.env.prod
#   # majd generálj új JWT_SECRET-et:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# MongoDB — az éles mongo konténer a belső hálózaton (koino-mongodb-prod)
MONGODB_URI=mongodb://mongodb:27017/koino

# Környezet: éles
NODE_ENV=production

# JWT titkos kulcs — IDE a generált véletlen string kerül (ne a mintát használd!)
JWT_SECRET=cseréld-le-egy-erős-véletlen-értékre

# Meghívásos regisztráció éles indulásnál: true (kontrollált első közösség)
MEGHIVAS_KOTELEZO=true

# ===== E-MAIL KÜLDÉS =====
# A koino MAGÁTÓL SOHA nem küld levelet — csak arra, amit az e-ember kifejezetten kért
# (cím-megerősítés, jelszó-helyreállítás, bekapcsolt e-mailes értesítés).
#
# EMAIL_SZOLGALTATO: 'naplo' | 'resend' | 'brevo'
#   naplo  = NEM megy ki valódi levél, csak a konzolra íródik. EZ AZ ALAPÉRTELMEZÉS,
#            és szándékosan ez a minta értéke is: aki elfelejti beállítani, annál
#            biztosan nem megy ki semmi.
#   resend / brevo = valódi küldés az adott szolgáltató API-ján át.
EMAIL_SZOLGALTATO=naplo

# A szolgáltató API-kulcsa. Amíg üres, a kapu MAGÁTÓL napló módba esik vissza
# (fail-safe: hiányos beállítással sosem próbálunk küldeni).
EMAIL_API_KULCS=

# A feladó. A domainnek hitelesítettnek kell lennie a szolgáltatónál (SPF/DKIM/DMARC
# DNS-rekordok a Cloudflare-ben), különben a levelek a spam mappában landolnak.
EMAIL_FELADO=koino <ertesites@koino.hu>

# A koino publikus címe — a levelekbe kerülő hivatkozások (cím-megerősítés,
# jelszó-helyreállítás) ebből épülnek. Éles: https://koino.hu
PUBLIKUS_URL=https://koino.hu

# A beállítás ellenőrzése (nem érint e-embert, csak a megadott címre küld):
#   docker exec koino-backend-prod node tools/emailProba.js sajat.cimem@pelda.hu
