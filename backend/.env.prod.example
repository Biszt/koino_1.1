# backend/.env.prod.example — MINTA az éles környezeti fájlhoz.
# Ez a fájl a gitben van (nincs benne valódi titok). Új gépen (pl. a jövőbeli
# szerver-gépen) másold le `.env.prod` néven, és tölts bele VALÓDI értékeket:
#
#   cp backend/.env.prod.example backend/.env.prod
#   # majd generálj új JWT_SECRET-et:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# MongoDB — az éles mongo konténer a belső hálózaton (koino-mongodb-prod)
MONGODB_URI=mongodb://mongodb:27017/koino

# Környezet: éles
NODE_ENV=production

# JWT titkos kulcs — IDE a generált véletlen string kerül (ne a mintát használd!)
JWT_SECRET=cseréld-le-egy-erős-véletlen-értékre

# Meghívásos regisztráció éles indulásnál: true (kontrollált első közösség)
MEGHIVAS_KOTELEZO=true
